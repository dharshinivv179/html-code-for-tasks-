
from IPython.display import HTML, display

html_code = """
<!DOCTYPE html>
<html>
<head>
<title>Action Item Extractor</title>

<style>
body {
    font-family: Arial;
    background: #eef2ff;
    padding: 25px;
}
.container {
    background: white;
    padding: 25px;
    border-radius: 12px;
    max-width: 750px;
    margin: auto;
}
h1 {
    color: #2563eb;
    text-align: center;
}
textarea {
    width: 100%;
    height: 160px;
    padding: 10px;
    box-sizing: border-box;
}
button {
    background: #2563eb;
    color: white;
    padding: 12px;
    border: none;
    margin-top: 10px;
    cursor: pointer;
}
table {
    width: 100%;
    margin-top: 20px;
    border-collapse: collapse;
}
th, td {
    border: 1px solid #ccc;
    padding: 10px;
    text-align: left;
}
th {
    background: #2563eb;
    color: white;
}
</style>
</head>

<body>

<div class="container">

<h1>Smart Action Item Extractor</h1>

<p>Enter your meeting notes:</p>

<textarea id="notes">Project Meeting

Rahul: Prepare project report by Friday.
Priya: Design homepage by Monday.
Arun: Complete database integration by Wednesday.
Sneha: Test application by Saturday.</textarea>

<br>

<button onclick="extractActions()">Extract Actions</button>
<button onclick="clearData()">Clear</button>

<h3>Extracted Action Items</h3>

<table>
<thead>
<tr>
<th>No</th>
<th>Owner</th>
<th>Task</th>
<th>Deadline</th>
</tr>
</thead>

<tbody id="result"></tbody>
</table>

<p id="message"></p>

</div>

<script>

function extractActions() {

let notes = document.getElementById("notes").value;
let lines = notes.split("\\n");
let result = document.getElementById("result");

result.innerHTML = "";

let count = 0;

lines.forEach(line => {

let match = line.trim().match(
/^([^:]+):\\s*(.+?)\\s+by\\s+([^\\.]+)\\.?$/i
);

if(match) {

count++;

let row = document.createElement("tr");

[ count, match[1], match[2], match[3] ].forEach(value => {
let cell = document.createElement("td");
cell.textContent = value;
row.appendChild(cell);
});

result.appendChild(row);

}

});

document.getElementById("message").textContent =
count + " action items extracted!";

}

function clearData() {
document.getElementById("notes").value = "";
document.getElementById("result").innerHTML = "";
document.getElementById("message").textContent = "";
}

</script>

</body>
</html>
"""

display(HTML(html_code))
